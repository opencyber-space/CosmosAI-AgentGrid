{
    "identity": {
        "subject_id": "ultravideotech-head",
        "subject_name": "ultravideotech-head",
        "subject_type": "agent",
        "subject_version": {
            "version": "1.0.0",
            "release_tag": "stable"
        }
    },
    "info": {
        "container_image_name": "${DOCKER_REGISTRY}/ultravideotech-head:latest"
    },
    "metadata": {
        "subject_description": "Head Agent for UltraVideoTech. Final authority on whether the company bids: weighs financial viability, certification evidence and past-project track record against the RFP, and approves or refuses.",
        "subject_search_tags": [
            "approval",
            "governance",
            "head-agent",
            "video-analytics",
            "ultravideotech"
        ],
        "subject_traits": [
            "authoritative",
            "risk-aware",
            "decisive"
        ],
        "subject_metadata": {
            "category": "video_analytics_bidding",
            "company": "UltraVideoTech",
            "company_slug": "ultravideotech",
            "role": "head"
        }
    },
    "persona": {
        "role": "head",
        "goal": "Approve the bid only when it is commercially viable and evidentially supportable.",
        "persona": "Accountable approver. Refuses when the evidence is not there.",
        "default_system_message": "You are the Head Agent for UltraVideoTech, the final approver.",
        "config": {
            "parameters": {
                "COMPANY": "UltraVideoTech",
                "COMPANY_SLUG": "ultravideotech",
                "AGENT_ROLE": "head",
                "AGENT_SELECTOR_LLM": "openai:gpt-5.4-mini",
                "HIS_CONFIG": {
                    "HIS_BASE_URL": "${HIS_BASE_URL}",
                    "HIS_POLL_INTERVAL": 1.0,
                    "HIS_MAX_WAIT": 120
                },
                "MINIO_CONFIG": {
                    "MINIO_URL": "${INTERNAL_IP}:${MINIO_INTERNAL_PORT}",
                    "MINIO_EXTERNAL_URL": "${EXTERNAL_IP}:${MINIO_EXTERNAL_PORT}",
                    "MINIO_ACCESS_KEY": "${MINIO_ACCESS_KEY}",
                    "MINIO_SECRET_KEY": "${MINIO_SECRET_KEY}",
                    "MINIO_INTERNAL_PORT": "${MINIO_INTERNAL_PORT}",
                    "MINIO_EXTERNAL_PORT": "${MINIO_EXTERNAL_PORT}",
                    "MINIO_BUCKET": "va-bidding-docs"
                },
                "api_key": "${OPENAI_API_KEY}",
                "BLOCKS_DB_URL": "${BLOCKS_DB_URL}",
                "INFERENCE_SERVER_ID": "${INFERENCE_SERVER_URL}",
                "EXCHANGE_BASE_URL": "${EXCHANGE_BASE_URL}",
                "ORCADE_URL": "${OPENARCADE_BIDDING_URL}",
                "ORCADE_POLL_SECONDS": "10",
                "FUNCTION_REGISTRY_URL": "${FUNCTION_REGISTRY_URL}",
                "FUNCTION_UPLOAD_URL": "${FUNCTION_UPLOAD_URL}",
                "FUNCTION_EXECUTOR_ID": "executor-001",
                "VA_ENDPOINT_VERSION": "1.1",
                "VA_ENDPOINT_RELEASE_TAG": "stable"
            }
        }
    },
    "prompting": {
        "default_system_template": "System: {{system_message}}",
        "input_template": "User: {{user_input}}",
        "output_template": "Assistant: {{assistant_output}}",
        "prompts_config": {
            "rfp_review": "Read the supplied RFP text and answer only from what it states. Do not invent requirements."
        }
    },
    "execution": {
        "logging_level": "INFO",
        "support_delegations": true,
        "execute_code": false,
        "enabled_memory_classes": [
            "short_term",
            "long_term"
        ]
    },
    "owner": {
        "org_id": "org-ultravideotech",
        "org_name": "UltraVideoTech",
        "team": "Bid Management"
    },
    "integrations": {
        "policies": [
            {
                "policy_type": "quota",
                "policy_rule_uri": "policies/quota-checker",
                "parameters": {
                    "max_requests_per_minute": 60
                },
                "settings": {
                    "enforce": true
                }
            }
        ],
        "models": [
            {
                "llm_type": "openai",
                "llm_block_id": "openai:gpt-5.4-mini",
                "llm_selection_query": {
                    "task": "reasoning"
                },
                "llm_parameters": {
                    "api_key": "${OPENAI_API_KEY}",
                    "max_completion_tokens": 16384,
                    "top_k": 50,
                    "top_p": 0.95,
                    "temperature": 0.2
                }
            }
        ],
        "memory_systems": [
            {
                "memory_id": "redis-memory",
                "memory_type": "short_term",
                "memory_backend": "redis",
                "memory_custom_config": {
                    "ttl": 3600
                }
            }
        ]
    },
    "runtime": {
        "resources": {
            "device": "cpu",
            "cpu_cores": 1,
            "memory_mb": 4096,
            "storage_mb": 4096,
            "gpu_count": 0,
            "env": {
                "LOG_LEVEL": "INFO",
                "SUBJECT_ID": "ultravideotech-head",
                "HIS_BASE_URL": "${HIS_BASE_URL}"
            }
        },
        "management_commands": [
            {
                "command": "reload_config",
                "command_description": "Re-read this company's config.yaml without restarting the pod"
            }
        ],
        "exchanges": [
            "central-exchange-001"
        ]
    }
}
