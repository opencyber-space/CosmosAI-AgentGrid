{
    "identity": {
        "subject_id": "newgentech-sizing",
        "subject_name": "newgentech-sizing",
        "subject_type": "agent",
        "subject_version": {
            "version": "1.0.0",
            "release_tag": "stable"
        }
    },
    "info": {
        "container_image_name": "${DOCKER_REGISTRY}/newgentech-sizing:latest"
    },
    "metadata": {
        "subject_description": "Sizing Agent for NewGenTech. Scales the company's per-licence hardware ratios by the licence counts the RFP asks for, fills the buyer's sizing template, and reports single totals for CPU, RAM, disk and accelerators.",
        "subject_search_tags": [
            "sizing",
            "hardware",
            "capacity-planning",
            "video-analytics",
            "newgentech"
        ],
        "subject_traits": [
            "methodical",
            "quantitative",
            "precise"
        ],
        "subject_metadata": {
            "category": "video_analytics_bidding",
            "company": "NewGenTech",
            "company_slug": "newgentech",
            "role": "sizing"
        }
    },
    "persona": {
        "role": "sizing",
        "goal": "Produce a filled sizing workbook and four authoritative hardware totals.",
        "persona": "Methodical engineer. Numbers are computed, never estimated in prose.",
        "default_system_message": "You are the Sizing Agent for NewGenTech.",
        "config": {
            "parameters": {
                "COMPANY": "NewGenTech",
                "COMPANY_SLUG": "newgentech",
                "AGENT_ROLE": "sizing",
                "AGENT_SELECTOR_LLM": "openai:gpt-5.4-mini",
                "HIS_CONFIG": {
                    "HIS_BASE_URL": "${HIS_BASE_URL}",
                    "HIS_POLL_INTERVAL": 1.0,
                    "HIS_MAX_WAIT": 120
                },
                "MINIO_CONFIG": {
                    "MINIO_URL": "${INTERNAL_IP}:${MINIO_INTERNAL_PORT}",
                    "MINIO_EXTERNAL_URL": "${EXTERNAL_IP}:${MINIO_EXTERNAL_PORT}",
                    "MINIO_ACCESS_KEY": "${MINIO_ACCESS_KEY}",
                    "MINIO_SECRET_KEY": "${MINIO_SECRET_KEY}",
                    "MINIO_INTERNAL_PORT": "${MINIO_INTERNAL_PORT}",
                    "MINIO_EXTERNAL_PORT": "${MINIO_EXTERNAL_PORT}",
                    "MINIO_BUCKET": "va-bidding-docs"
                },
                "api_key": "${OPENAI_API_KEY}",
                "BLOCKS_DB_URL": "${BLOCKS_DB_URL}",
                "INFERENCE_SERVER_ID": "${INFERENCE_SERVER_URL}",
                "EXCHANGE_BASE_URL": "${EXCHANGE_BASE_URL}",
                "ORCADE_URL": "${OPENARCADE_BIDDING_URL}",
                "ORCADE_POLL_SECONDS": "10",
                "FUNCTION_REGISTRY_URL": "${FUNCTION_REGISTRY_URL}",
                "FUNCTION_UPLOAD_URL": "${FUNCTION_UPLOAD_URL}",
                "FUNCTION_EXECUTOR_ID": "executor-001",
                "VA_ENDPOINT_VERSION": "1.1",
                "VA_ENDPOINT_RELEASE_TAG": "stable"
            }
        }
    },
    "prompting": {
        "default_system_template": "System: {{system_message}}",
        "input_template": "User: {{user_input}}",
        "output_template": "Assistant: {{assistant_output}}",
        "prompts_config": {
            "rfp_review": "Read the supplied RFP text and answer only from what it states. Do not invent requirements."
        }
    },
    "execution": {
        "logging_level": "INFO",
        "support_delegations": true,
        "execute_code": false,
        "enabled_memory_classes": [
            "short_term",
            "long_term"
        ]
    },
    "owner": {
        "org_id": "org-newgentech",
        "org_name": "NewGenTech",
        "team": "Bid Management"
    },
    "integrations": {
        "policies": [
            {
                "policy_type": "quota",
                "policy_rule_uri": "policies/quota-checker",
                "parameters": {
                    "max_requests_per_minute": 60
                },
                "settings": {
                    "enforce": true
                }
            }
        ],
        "models": [
            {
                "llm_type": "openai",
                "llm_block_id": "openai:gpt-5.4-mini",
                "llm_selection_query": {
                    "task": "analysis"
                },
                "llm_parameters": {
                    "api_key": "${OPENAI_API_KEY}",
                    "max_completion_tokens": 16384,
                    "top_k": 50,
                    "top_p": 0.95,
                    "temperature": 0.2
                }
            }
        ],
        "memory_systems": [
            {
                "memory_id": "redis-memory",
                "memory_type": "short_term",
                "memory_backend": "redis",
                "memory_custom_config": {
                    "ttl": 3600
                }
            }
        ]
    },
    "runtime": {
        "resources": {
            "device": "cpu",
            "cpu_cores": 1,
            "memory_mb": 4096,
            "storage_mb": 4096,
            "gpu_count": 0,
            "env": {
                "LOG_LEVEL": "INFO",
                "SUBJECT_ID": "newgentech-sizing",
                "HIS_BASE_URL": "${HIS_BASE_URL}"
            }
        },
        "management_commands": [
            {
                "command": "reload_config",
                "command_description": "Re-read this company's config.yaml without restarting the pod"
            }
        ],
        "exchanges": [
            "central-exchange-001"
        ]
    }
}
