{
    "identity": {
        "subject_id": "senior-architect-agent",
        "subject_name": "Senior Architecture Architect",
        "subject_type": "agent",
        "subject_version": {
            "version": "1.0.0",
            "release_tag": "stable"
        }
    },
    "info": {
        "container_image_name": "${DOCKER_REGISTRY}/senior-architect-agent:latest"
    },
    "metadata": {
        "subject_description": "Evaluates software architecture plans for scalability, security, and workability. Provides approval or refinement feedback.",
        "subject_search_tags": [
            "architecture",
            "evaluator",
            "senior-architect"
        ],
        "subject_traits": [
            "critical",
            "experienced"
        ],
        "subject_metadata": {
            "category": "architect",
            "domain": "Software Engineering",
            "capabilities_metadata": {
                "description": "Reviews architecture proposals and ensures they meet enterprise standards.",
                "inputs": [
                    "proposed_architecture",
                    "debate_history"
                ],
                "outputs": [
                    "is_approved",
                    "reasoning",
                    "response"
                ]
            }
        }
    },
    "persona": {
        "role": "senior-architect-agent",
        "goal": "Evaluate architect designs for scalability, security, and workability until they meet senior standards.",
        "persona": "Experienced Senior Solutions Architect with deep knowledge of systems design.",
        "default_system_message": "    You are the Senior Solutions Architect.\n    Evaluate a SPECIFIC component of the software architecture proposed by the Software Agent.\n    \n    QUANTITATIVE SCRUTINY:\n    - Mathematically evaluate the proposed design:\n      - Is the Load prediction realistic for the user's request?\n      - Are the RAM, CPU, and Disk estimates sufficient or overkill?\n      - Will the proposed architecture meet the required Network Bandwidth and Latency targets?\n    \n    CREATIVE PROBING:\n    - Don't just check requirement compliance.\n    - Ask \"CRAZY\" questions: \"What if the DB node vanishes?\", \"What if network latency spikes to 500ms?\", \"What if a rogue consumer deletes all data?\"\n    - Your goal is to break the design to ensure it's bulletproof.\n    - Assign a 'satisfaction_score' (0-100).\n    - Only approve if description is technically flawless and satisfaction_score >= 95.",
        "config": {
            "parameters": {
                "INFERENCE_SERVER_REGISTRY_URL": "http://<AIOS-INFERENCE-REGISTRY>/api",
                "BLOCKS_DB_URL": "${BLOCKS_DB_URL}",
                "INFERENCE_SERVER_ID": "${INFERENCE_SERVER_URL}",
                "AGENT_SELECTOR_LLM": "qwen3-1-7b-vllm-block",
                "HIS_CONFIG": {
                    "HIS_BASE_URL": "${HIS_BASE_URL}",
                    "HIS_POLL_INTERVAL": 1.0,
                    "HIS_MAX_WAIT": 120
                }
            }
        }
    },
    "prompting": {
        "default_system_template": "System: {{system_message}}",
        "input_template": "User: {{user_input}}",
        "output_template": "Assistant: {{assistant_output}}",
        "prompts_config": {
            "summarize": "Please summarize the following text in under 200 words.",
            "qa": "Answer the question based only on the provided documents."
        }
    },
    "execution": {
        "logging_level": "DEBUG",
        "support_delegations": true,
        "execute_code": false,
        "enabled_memory_classes": [
            "short_term",
            "long_term",
            "context"
        ]
    },
    "integrations": {
        "policies": [
            {
                "policy_type": "quota",
                "policy_rule_uri": "policies/quota-checker",
                "parameters": {
                    "max_requests_per_minute": 60
                },
                "settings": {
                    "enforce": true
                }
            }
        ],
        "dsls": [
            {
                "dsl_type": "workflow",
                "dsl_workflow_id": "wf-123",
                "dsl_parameters": {
                    "steps": [
                        "fetch_docs",
                        "summarize"
                    ]
                }
            }
        ],
        "models": [
            {
                "llm_type": "vllm",
                "llm_block_id": "aios:qwen3-1-7b-vllm-block",
                "llm_selection_query": {
                    "task": "summarization"
                },
                "llm_parameters": {
                    "max_tokens": 10240,
                    "top_k": 50,
                    "top_p": 0.95,
                    "temperature": 1.0
                }
            }
        ],
        "addons": [
            {
                "addon_id": "translation-addon",
                "addon_type": "translation",
                "addon_config": {
                    "languages": [
                        "fr",
                        "de",
                        "es"
                    ]
                }
            }
        ],
        "contracts": [
            {
                "contract_type": "license",
                "contract_id": "contract-001",
                "contract_parameters": {
                    "expiry": "2026-01-01"
                }
            }
        ],
        "subject_tools": [
            {
                "tool_id": "meeting-planner-discussion-point-getter",
                "tool_description": "Help meeting organisers to get all points needed for discussion in meeting",
                "tool_execution_mode": "remote",
                "tool_custom_config": {
                    "embedding_dim": 768
                },
                "tool_calling_config": {
                    "endpoint": "http://tools.svc.local/search"
                }
            }
        ],
        "subject_functions": [
            {
                "function_id": "summarize_text",
                "function_custom_parameters": {
                    "max_length": 300
                },
                "function_calling_config": {
                    "timeout": 5
                }
            }
        ],
        "memory_systems": [
            {
                "memory_id": "redis-memory",
                "memory_type": "short_term",
                "memory_backend": "redis",
                "memory_custom_config": {
                    "ttl": 3600
                }
            }
        ],
        "sub_systems": [
            {
                "sub_system_id": "kg-subsystem",
                "sub_system_type": "knowledge_graph",
                "sub_system_config": {
                    "db_uri": "bolt://neo4j:7687"
                }
            }
        ],
        "builtin_modules": [
            {
                "module_id": "summarizer",
                "module_description": "Summarizes long documents into concise notes",
                "module_input_template": "Input: {{text}}",
                "module_output_template": "Summary: {{summary}}",
                "module_management_commands": [
                    {
                        "command": "reset_cache",
                        "command_description": "Clears internal caches"
                    }
                ]
            }
        ]
    },
    "runtime": {
        "resources": {
            "device": "cpu",
            "cpu_cores": 4,
            "memory_mb": 1024,
            "storage_mb": 512,
            "gpu_count": 0,
            "gpu_memory_mb": 0,
            "node_selector": {
                "gpu": "false"
            },
            "env": {
                "HF_HOME": "/models",
                "LOG_LEVEL": "DEBUG"
            }
        },
        "management_commands": [
            {
                "command": "scale_up",
                "command_description": "Increase replicas for high load"
            }
        ],
        "exchanges": [
            "central-exchange-001"
        ]
    },
    "owner": {
        "org_id": "org-789",
        "org_name": "AI Research Lab",
        "team": "Knowledge Systems",
        "owners": [
            "alice@example.com",
            "bob@example.com"
        ],
        "contacts": {
            "slack": "#ai-research",
            "pagerduty": "pd-ai-team"
        }
    }
}