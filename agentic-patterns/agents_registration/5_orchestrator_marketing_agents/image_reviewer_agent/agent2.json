{
    "identity": {
        "subject_id": "marketing-image-reviewer-agent",
        "subject_name": "marketing-image-reviewer-agent",
        "subject_type": "agent",
        "subject_version": {
            "version": "1.0.0",
            "release_tag": "stable"
        }
    },
    "info": {
        "container_image_name": "${DOCKER_REGISTRY}/marketing-image-reviewer-agent:latest"
    },
    "metadata": {
        "subject_description": "Handle the work for marketing campaign by reveiwing the generated image prompt with description given.",
        "subject_search_tags": [
            "marketing",
            "marketing-image-reviewer-agent"
        ],
        "subject_traits": [
            "fast",
            "accurate",
            "multi-lingual"
        ],
        "subject_metadata": {
            "category": "assistant",
            "domain": "NLP",
            "capabilities_metadata": {
                "description": "Brand guardian. Reviews imagery for cultural alignment and provides constructive feedback. Should follow image generation.",
                "inputs": [
                    "image_url",
                    "campaign_content",
                    "market_name"
                ],
                "outputs": [
                    "cultural_alignment_score",
                    "review_feedback",
                    "approval_status"
                ]
            }
        }
    },
    "persona": {
        "role": "marketing-image-reviewer-agent",
        "goal": "Handle the work for marketing campaign by reveiwing the generated image prompt with description given.",
        "persona": "Polite, concise, and focused on factual accuracy.",
        "default_system_message": "### ROLE\n    You are a Brand Cultural Consultant. Your task is to review the proposed image concepts \n    and campaign content to ensure they are culturally appropriate for the target market \n    and align perfectly with the brand's localized strategy.\n\n    ### INSTRUCTIONS\n    1. IMAGE MANDATORY: You MUST have a valid image input to perform a review. If the 'image' input is missing, empty, or invalid, you cannot provide a score or feedback.\n    2. REVIEW for cultural sensitivity and potential taboos in the target market.\n    3. ALIGNMENT: Ensure the visual concept matches the campaign's message.\n    4. FEEDBACK: Provide constructive feedback for the local market manager.\n\n    ### OUTPUT EXPECTATION\n    Output a structured review of the proposed creative. If no image is provided, explicitly state that the review was skipped.\n\n    ### MANDATORY OUTPUT STRUCTURE\n    You MUST follow this exact structure for your output:\n    \n    ## Cultural Alignment Score: {score}/10 (e.g., 9/10)\n    ## Review Feedback: {Detailed feedback on image and content}\n    ## Approval Status: {Approved/Needs Revision}",
        "config": {
            "parameters": {
                "mux_size": 1,
                "INFERENCE_SERVER_REGISTRY_URL": "http://<AIOS-INFERENCE-REGISTRY>/api",
                "BLOCKS_DB_URL": "${BLOCKS_DB_URL}",
                "INFERENCE_SERVER_ID": "${INFERENCE_SERVER_URL}",
                "AGENT_SELECTOR_LLM": "qwen3-1-7b-vllm-block"
            }
        }
    },
    "prompting": {
        "default_system_template": "System: {{system_message}}",
        "input_template": "User: {{user_input}}",
        "output_template": "Assistant: {{assistant_output}}",
        "prompts_config": {
            "summarize": "Please summarize the following text in under 200 words.",
            "qa": "Answer the question based only on the provided documents."
        }
    },
    "execution": {
        "logging_level": "DEBUG",
        "support_delegations": true,
        "execute_code": false,
        "enabled_memory_classes": [
            "short_term",
            "long_term",
            "context"
        ]
    },
    "integrations": {
        "policies": [
            {
                "policy_type": "quota",
                "policy_rule_uri": "policies/quota-checker",
                "parameters": {
                    "max_requests_per_minute": 60
                },
                "settings": {
                    "enforce": true
                }
            }
        ],
        "dsls": [
            {
                "dsl_type": "workflow",
                "dsl_workflow_id": "wf-123",
                "dsl_parameters": {
                    "steps": [
                        "fetch_docs",
                        "summarize"
                    ]
                }
            }
        ],
        "models": [
            {
                "llm_type": "google",
                "llm_block_id": "google:gemini/gemini-2.5-flash",
                "llm_selection_query": {
                    "task": "image generation"
                },
                "llm_parameters": {
                    "api_key": "${GEMINI_API_KEY}",
                    "max_tokens": 512,
                    "top_k": 50,
                    "top_p": 0.95,
                    "temperature": 1.0
                }
            }
        ],
        "addons": [
            {
                "addon_id": "translation-addon",
                "addon_type": "translation",
                "addon_config": {
                    "languages": [
                        "fr",
                        "de",
                        "es"
                    ]
                }
            }
        ],
        "contracts": [
            {
                "contract_type": "license",
                "contract_id": "contract-001",
                "contract_parameters": {
                    "expiry": "2026-01-01"
                }
            }
        ],
        "subject_tools": [
            {
                "tool_id": "meeting-planner-discussion-point-getter",
                "tool_description": "Help meeting organisers to get all points needed for discussion in meeting",
                "tool_execution_mode": "remote",
                "tool_custom_config": {
                    "embedding_dim": 768
                },
                "tool_calling_config": {
                    "endpoint": "http://tools.svc.local/search"
                }
            }
        ],
        "subject_functions": [
            {
                "function_id": "summarize_text",
                "function_custom_parameters": {
                    "max_length": 300
                },
                "function_calling_config": {
                    "timeout": 5
                }
            }
        ],
        "memory_systems": [
            {
                "memory_id": "redis-memory",
                "memory_type": "short_term",
                "memory_backend": "redis",
                "memory_custom_config": {
                    "ttl": 3600
                }
            }
        ],
        "sub_systems": [
            {
                "sub_system_id": "kg-subsystem",
                "sub_system_type": "knowledge_graph",
                "sub_system_config": {
                    "db_uri": "bolt://neo4j:7687"
                }
            }
        ],
        "builtin_modules": [
            {
                "module_id": "summarizer",
                "module_description": "Summarizes long documents into concise notes",
                "module_input_template": "Input: {{text}}",
                "module_output_template": "Summary: {{summary}}",
                "module_management_commands": [
                    {
                        "command": "reset_cache",
                        "command_description": "Clears internal caches"
                    }
                ]
            }
        ]
    },
    "runtime": {
        "resources": {
            "device": "cpu",
            "cpu_cores": 4,
            "memory_mb": 1024,
            "storage_mb": 512,
            "gpu_count": 0,
            "gpu_memory_mb": 0,
            "node_selector": {
                "gpu": "false"
            },
            "env": {
                "HF_HOME": "/models",
                "LOG_LEVEL": "DEBUG"
            }
        },
        "management_commands": [
            {
                "command": "scale_up",
                "command_description": "Increase replicas for high load"
            }
        ],
        "exchanges": [
            "central-exchange-001"
        ]
    },
    "owner": {
        "org_id": "org-789",
        "org_name": "AI Research Lab",
        "team": "Knowledge Systems",
        "owners": [
            "alice@example.com",
            "bob@example.com"
        ],
        "contacts": {
            "slack": "#ai-research",
            "pagerduty": "pd-ai-team"
        }
    }
}