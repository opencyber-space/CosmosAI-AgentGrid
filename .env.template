# Environment Variable Template
# Copy this file to .env and fill in your local IP addresses and configuration.

# Primary Server Node IP (Hosts Docker registry and major APIs)
PRIMARY_NODE_IP="X.X.X.X"

# API Endpoints mapped to Primary Node
API_BASE_URL="http://${PRIMARY_NODE_IP}:30721"
DELEGATE_API_URL="http://${PRIMARY_NODE_IP}:30725"
DIRECT_API_URL="http://${PRIMARY_NODE_IP}:31709"
JOB_EXCHANGE_API_URL="http://${PRIMARY_NODE_IP}:30708"
SUBJECT_DB_URL="http://${PRIMARY_NODE_IP}:30721"
HIS_BASE_URL="http://${PRIMARY_NODE_IP}:30608"
# For Chat Server
WS_URL="ws://${PRIMARY_NODE_IP}:30728/ws"

#FOR FUNCTIONS
FUNCTION_REGISTRY_URL="http://${PRIMARY_NODE_IP}:30701"
FUNCTION_UPLOAD_URL="http://${PRIMARY_NODE_IP}:30701"

#FOR TOOLS
TOOLS_REGISTRY_URL="http://${PRIMARY_NODE_IP}:30702"

# Docker Registry
DOCKER_REGISTRY="${PRIMARY_NODE_IP}:31280/agents"

