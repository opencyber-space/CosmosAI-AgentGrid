# Policy Database Configuration
POLICY_DB_IP="X.X.X.X"
POLICY_DB_URL="http://${POLICY_DB_IP}:30102"
POLICY_UPLOAD_URL="http://${POLICY_DB_IP}:30186"

# Agent Configuration JSON Overrides
BLOCKS_DB_IP="X.X.X.X"
BLOCKS_DB_URL="http://${BLOCKS_DB_IP}:30100"

INFERENCE_SERVER_IP="X.X.X.X"
INFERENCE_SERVER_URL="http://${INFERENCE_SERVER_IP}:31504"

AIGRID_MASTER="<AI_GRID_MASTER_IP>"
AIGRID_INFERENCE_SERVER_URL="http://<INFERENCE_SERVER_IP>:31504"

GEMINI_API_KEY="<YOUR_GEMINI_API_KEY_GOES_HERE>"
OPENAI_API_KEY="<YOUR OPENAI API KEY GOES HERE>"

# MinIO Credentials
MINIO_ACCESS_KEY="<YOUR_MINIO_ACCESS_KEY_GOES_HERE>"
MINIO_SECRET_KEY="<YOUR_MINIO_SECRET_KEY_GOES_HERE>"
