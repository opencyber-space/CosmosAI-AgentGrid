  "tool_custom_actions_dsl_map": {
    "forge_schema": {
      "description": "Infer JSON Schema and docs from sample data",
      "call": "execute",
      "args": {
        "$ref": "$.input"
      }
    },
    "set_kv": {
      "description": "Set a KV pair",
      "call": "execute_command",
      "args": {
        "command": "set",
        "data": {
          "key": "$.key",
          "value": "$.value"
        }
      }
    },
    "get_kv": {
      "description": "Get a KV value",
      "call": "execute_command",
      "args": {
        "command": "get",
        "data": {
          "key": "$.key"
        }
      }
    },
    "reset_state": {
      "description": "Reset history, KV, and call counter",
      "call": "execute_command",
      "args": {
        "command": "reset",
        "data": {}
      }
    }
  },
