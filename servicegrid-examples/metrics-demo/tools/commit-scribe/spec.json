            },
            "repo_context": {
              "type": "string"
            },
            "branch_name": {
              "type": "string"
            }
          },
          "required": [
            "diff"
          ]
        },
        "output": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "tool_id": {
              "type": "string"
            },
            "calls": {
              "type": "integer"
            },
            "op": {
              "type": "string"
            },
            "commit_message": {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string"
                },
                "scope": {
                  "type": "string"
                },
                "subject": {
                  "type": "string"
                },
                "body": {
