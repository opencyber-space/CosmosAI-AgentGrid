                }
              }
            },
            "history_len": {
              "type": "integer"
            },
            "persisted": {
              "type": "boolean"
            }
          },
          "required": [
            "ok",
            "tool_id",
            "calls",
            "op",
            "commit_message"
          ]
        }
      },
