{
  "tool_id": "agentspace.commit-scribe.v4",
  "tool_metadata": {
    "version": "1.0.1",
    "author": "admin",
    "license": "Apache-2.0",
    "defaults": {
      "model": "gpt-4o-mini",
      "convention": "conventional-commits",
      "persist_state": false,
      "max_history": 50,
      "autosave_every": 0,
      "counter_start": 0
    }
  },
  "tool_search_description": "Generates Conventional Commit messages from git diffs using OpenAI. Returns type, scope, subject, body, breaking changes, and suggested issue links.",
  "tool_tags": [
    "git",
    "commits",
    "openai",
    "developer-productivity",
    "conventional-commits"
  ],
  "tool_type": "local-python-tool",
  "tool_man_page_doc": "NAME\n    agentspace.commit-scribe.v3 - Generate Conventional Commit messages from git diffs.\n\nSYNOPSIS\n    execute(input) -> result\n    execute_command(name, data) -> result\n\nDESCRIPTION\n    Calls OpenAI with a git diff and produces a complete commit message following\n    the Conventional Commits spec (or freeform). Maintains call history and KV state.\n\nEXECUTE INPUT\n    diff         (str, required)  Output of `git diff` or `git diff --cached`\n    repo_context (str, optional)  Brief description of the repo/domain\n    branch_name  (str, optional)  Current branch name (helps infer scope/issue)\n\nEXECUTE OUTPUT\n    commit_message.type              feat|fix|refactor|...\n    commit_message.scope             inferred from file paths\n    commit_message.subject           imperative summary <=72 chars\n    commit_message.body              WHY explanation\n    commit_message.breaking_changes  list of breaking changes\n    commit_message.suggested_issues  e.g. [\"closes #42\"]\n    commit_message.full_message      paste-ready complete message\n\nCOMMANDS\n    set         data={\"key\": str, \"value\": any}\n    get         data={\"key\": str}\n    reset       data={}\n    get_state   data={}\n    save        data={} (requires persist_state=true)\n    load        data={} (requires persist_state=true)\n\nEXAMPLES\n    execute({\"diff\": \"diff --git a/auth/login.py ...\", \"branch_name\": \"fix/token-validation\"})\n    execute_command(\"set\", {\"key\": \"last_pr\", \"value\": 99})\n    execute_command(\"get_state\", {})",
  "tool_api_spec": {
